# ─── Airtable Configuration ───────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Your Airtable Personal Access Token
# Create one at: https://airtable.com/account → Developer hub → Personal access tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read
VITE_AIRTABLE_API_KEY=patXXXXXXXXXXXXXX

# Your Airtable Base ID
# Found in the URL when viewing your base: https://airtable.com/appXXXXXXXXXX/...
VITE_AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# ─── Table Names ──────────────────────────────────────────────────────────────
# These must exactly match the table names in your Airtable base.
VITE_TABLE_GAMES=Games
VITE_TABLE_PRODUCT_GOALS=Product Goals
VITE_TABLE_PLAYER_EXPERIENCE_GOALS=Player Experience Goals
VITE_TABLE_STUDIES=Studies
